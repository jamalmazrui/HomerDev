# .gitignore for HomerDev, generated by homerTidy on 2026-09-25.
#
# THIS IS A WHITELIST. Everything is ignored, and then exactly what
# RepoFiles.txt names is put back. A file dropped into this folder is
# invisible to git until somebody names it there, which is the point: the
# file that gets pushed by accident is always the one nobody thought of.
#
# To add a file to the repository, add one line to RepoFiles.txt and run
# homerTidy again. Do not edit this file by hand; it is overwritten.

# Ignore everything.
/*

# Put back what the project names.
!/.gitignore
!/buildHomerDev.cmd
!/buildHomerDev.py
!/checkHomerDev.cmd
!/checkHomerDev.py
!/createHomerDevRepo.cmd
!/createHomerDevRepo.ps1
!/CSharp/
!/help/
!/homer/
!/License.htm
!/License.md
!/LocalFiles.txt
!/newHomerApp.cmd
!/newHomerApp.py
!/ReadMe.htm
!/ReadMe.md
!/releaseHomerDev.cmd
!/RepoFiles.txt
!/Samples/
!/scripts/
!/Templates/
!/version.txt
!/.gitignore

# On this disk only, from LocalFiles.txt.
exec/
logs/

# Never pushed, whatever RepoFiles.txt says: private notes, maintainer
# scripts, logs, and anything a build makes.
*.exe
*.log
*.obj
*.pdb
Version.cs
__pycache__/
.venv/
build/
create*Repo.cmd
create*Repo.ps1
dist/
notes/
