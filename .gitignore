!/ReadMe.htm
!/ReadMe.md
!/RepoFiles.txt
!/Samples/
!/Style/
!/Templates/
!/Tools/
!/Tutorial_HomerDev.inix
!/version.txt
!/.gitignore

# Never pushed, whatever RepoFiles.txt says: private notes, maintainer
