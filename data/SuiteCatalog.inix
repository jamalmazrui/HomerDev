apps=DbDo, FileDir
key=Control+L
description=Read {lean} from the current {thing} on

[command Read Lean Marked from Current]
apps=DbDo, FileDir
key=
description=Read {lean} in the marked {things}, from the current one on

[command Say Yield from Current]
