[command Say Status]
; EDSHARP ONLY (26 November 2026, Jamal: no Homer app reads its status bar whole; JAWS and NVDA have keys for that).
; DbDo's said facts each with its own key, so it is retired there; FileDir's Shift+Z says the timer instead. EdSharp's
; says whether the document is modified, and its encoding, which no other key says, so it stays.
apps=EdSharp
key=Alt+Z
description=Say {what}

[command Say Windows Open]
apps=DbDo, EdSharp, FileDir
key=Shift+F4
description=Say how many windows are open, and their titles

[command Say Yield]
; FILEDIR JOINS (15 November 2026, the keyboard audit's A11): its Yield became Say Yield on Alt+Y, and Yield Files
; moved to Control+Y, so Alt+Y says the yield of everything in view in every Homer app.
apps=DbDo, EdSharp, FileDir, HomerView
key=Alt+Y
description=Say how many {what}

;
; THE L AND Y KEYS OF THE TWO LIST APPS (21 November 2026, Jamal's ruling: DbDo and FileDir have the same commands, as a
; suite should). L is lean, one column: DbDo's current column, FileDir's names. Alt reads from the first, Alt+Shift the
; marked, Control from the current one; the marked-from-current form keeps no key, since Control+Shift+Y is Yield
; with Regex and FileDir's Control+Shift+L is Path List to Clipboard (Play List until 21 November 2026). DbDo's W keys are its own: FileDir's list has one column.
[command Read Lean]
apps=DbDo, FileDir
key=Alt+L
description=Read {lean} from the first {thing}

[command Read Lean Marked]
apps=DbDo, FileDir
key=Alt+Shift+L
description=Read {lean} in the marked {things}, from the first

