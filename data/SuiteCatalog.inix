[command Play Media]
; ONE PLAY COMMAND, IN THE HOMER PLAYER (21 November 2026, the AV group): FileDir's Play Media handed a list to mpv's own
; window and its Homer Player had Control+Shift+H; now Play Media plays in the Homer Player in both list apps, and
; Homer Player is retired into it. Play List keeps no key in FileDir; Control+Shift+L went to Path List to Clipboard.
apps=DbDo, FileDir
key=Control+P
description=Play {playwhat} in the Homer Player

[command Record Playback]
; RECORD PLAYBACK (21 November 2026, the AV group): Shift adds recording to Play Media, and P begins Playback, so the
; letter is in the name. It is the Homer Player's Capture stream button, pressed when the player opens.
apps=DbDo, FileDir
key=Control+Shift+P
description=Play as Play Media does, and record what plays to Music, Homer Player

[command Mail]
; ONE MAIL (21 November 2026): Mail Body and Mail Attachment became Mail on Control+M, which puts the text in the body
; and attaches the file, so Control+Shift+M is free for FileDir's Move to Folder.
; CONTROL+M IS MAIL IN EVERY HOMER APP (24 November 2026, Jamal), DbDo's Mail Record included.
apps=EdSharp, FileDir
key=Control+M
description=Email {mailwhat}

[command Mark All]
apps=DbDo, FileDir
key=Control+A
description=Mark every {thing} in view

