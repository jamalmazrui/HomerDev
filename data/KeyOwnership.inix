[Key NumPadPlus]
owner=NVDA
kind=conditional
what=say all with review
context=everywhere, in NVDA's desktop layout with Num Lock off
interception=taken by NVDA before the app
disposition=never bind as an app's only key

[Key NumPadSlash]
owner=JAWS and NVDA
kind=conditional
what=left mouse click
context=everywhere, with Num Lock off (JAWS turns it off; NVDA's desktop layout)
interception=taken by the reader before the app
disposition=never bind as an app's only key

[Key NumPadStar]
owner=JAWS and NVDA
kind=conditional
what=right mouse click
context=everywhere, with Num Lock off (JAWS turns it off; NVDA's desktop layout)
interception=taken by the reader before the app
disposition=kept only as a second key beside one that always works, such as DbDo's Shift+8; test under both readers

[Key Alt+UpArrow]
owner=NVDA
kind=conditional
what=previous sentence
context=in documents where NVDA supports sentence movement
interception=NVDA moves by sentence itself where it can, and otherwise hands the key on
disposition=kept for a Homer app's own Previous Sentence, which means the same thing; test under NVDA that the app's command runs

[Key Alt+DownArrow]
owner=NVDA
kind=conditional
what=next sentence
context=in documents where NVDA supports sentence movement
interception=NVDA moves by sentence itself where it can, and otherwise hands the key on
disposition=kept for a Homer app's own Next Sentence, which means the same thing; test under NVDA that the app's command runs

[Key Alt+Control+Home]
owner=NVDA
kind=reader tables
what=first column
context=in tables NVDA recognizes
interception=NVDA moves to the first column itself
disposition=allowed for cell movement inside the app's own grid only, tested

; JAWS'S SCRIPTS ON THE APPS' OWN KEYS (kit 1.259.0, 18 November 2026), from JAWS's own default key maps of 2024 to
; 2027. Each key means the same in the app as everywhere, but JAWS answers it with a script of its own; FileDir
; and EdSharp hand each one straight to the app, and DbDo did not. Alt+Enter, Control+A, Control+F4 and Control+Space
; are above, with passThrough added. Listed here, tidy writes the same line into
; every app's key map that binds the key, so the app's own speech is the only speech.

[Key Control+E]
owner=JAWS
kind=convention
what=move to a search box, in programs that have one (JAWS script ActivateSearchBox)
context=everywhere
interception=JAWS runs its script, which sends the key on and may speak first
disposition=passed through to the app, wherever it binds the key, as FileDir's and EdSharp's key maps already do
passThrough=yes
passThroughExcept=HomerView, whose key map is chained into the browsers', where these keys are JAWS's own

[Key Control+P]
owner=JAWS
kind=convention
what=play, in FSReader (JAWS script FSReaderPlay)
context=everywhere
interception=JAWS runs its script, which sends the key on and may speak first
disposition=passed through to the app, wherever it binds the key, as FileDir's and EdSharp's key maps already do
passThrough=yes
passThroughExcept=HomerView, whose key map is chained into the browsers', where these keys are JAWS's own

[Key F3]
owner=JAWS
kind=convention
what=find next, as JAWS announces it in some programs (JAWS script F3Script)
context=everywhere
interception=JAWS runs its script, which sends the key on and may speak first
disposition=passed through to the app, wherever it binds the key, as FileDir's and EdSharp's key maps already do
passThrough=yes
passThroughExcept=HomerView, whose key map is chained into the browsers', where these keys are JAWS's own

[Key Shift+F3]
owner=JAWS
kind=convention
what=find previous, as JAWS announces it in some programs (JAWS script ShiftF3Script)
context=everywhere
interception=JAWS runs its script, which sends the key on and may speak first
disposition=passed through to the app, wherever it binds the key, as FileDir's and EdSharp's key maps already do
passThrough=yes
passThroughExcept=HomerView, whose key map is chained into the browsers', where these keys are JAWS's own
