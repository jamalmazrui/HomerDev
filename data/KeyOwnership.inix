; KeyOwnership.inix -- keys owned by Windows, screen readers and browsers, and
; what a Homer app may do with each. The authority for scripts\checkKeys and
; for the short table inside exec\CSharp\KeyMap.cs, which checkKeys compares
; with this file.
;
; kind: system (Windows takes it first), convention (the app receives it but
; it means one thing everywhere), conditional (taken only on some machines),
; reader global, reader tables, reader laptop, browser, historical.
;
; Sources: Microsoft's Windows 11 shortcut list, Freedom Scientific's JAWS
; keystroke list and JAWS Basic Training, NV Access's NVDA user guide (its
; desktop-layout commands that need no NVDA key), the Window-Eyes reference. Also always reserved: every
; Windows-key and Insert-key combination, Alt+Control with letters, digits,
; function keys or punctuation, and Control+Alt+N, which starts NVDA.

[Ownership]
schema=1

[Key Alt+Tab]
owner=Windows
kind=system
what=switches apps
context=everywhere
interception=taken before any app
disposition=never bind

[Key Alt+Escape]
owner=Windows
kind=system
what=cycles windows
context=everywhere
interception=taken before any app
disposition=never bind

[Key Alt+Space]
owner=Windows
kind=system
what=system menu
context=everywhere
interception=opens the window's system menu
disposition=never bind

[Key Alt+Dash]
owner=Windows
kind=system
what=document window menu
context=MDI document windows
interception=opens a document window's system menu
disposition=never bind in an MDI app

[Key Control+Escape]
owner=Windows
kind=system
what=Start
context=everywhere
interception=taken before any app
disposition=never bind

[Key Control+Shift+Escape]
owner=Windows
kind=system
what=Task Manager
context=everywhere
interception=taken before any app
disposition=never bind

[Key Alt+Control+Delete]
owner=Windows
kind=system
what=security screen
context=everywhere
interception=taken before any app
disposition=never bind

[Key PrintScreen]
owner=Windows
kind=system
what=screenshot
context=everywhere
interception=screenshot or Snipping Tool
disposition=never bind

[Key F10]
owner=Windows
kind=convention
what=menu bar
context=any app with a menu bar
interception=the app receives it; Windows moves to the menu bar by default
disposition=bind only to the menu bar

[Key Shift+F10]
owner=Windows
kind=convention
what=context menu
context=any app
interception=the app receives it; it opens the context menu
disposition=bind only to a context menu

[Key Control+Space]
owner=Windows
kind=conditional
what=input method on or off
context=only with a Chinese input method installed
interception=the input method may take it
disposition=allowed, recorded as an input-method exception and tested
jaws=JAWS answers it with its own script, SelectCurrentItem, before the app (kit 1.259.0, from JAWS's default key maps of 2024 to 2027)
passThrough=yes
passThroughExcept=HomerView, whose key map is chained into the browsers', where these keys are JAWS's own

[Key Control+Shift+0]
owner=Windows
kind=conditional
what=keyboard layout hotkey
context=machines with more than one keyboard layout
interception=the layout hotkey may take it
disposition=do not bind

[Key Control+A]
owner=Windows
kind=convention
what=select all
context=everywhere
interception=the app receives it
disposition=bind only to select all, or mark all in a list
jaws=JAWS answers it with its own script, SelectAll, before the app (kit 1.259.0, from JAWS's default key maps of 2024 to 2027)
passThrough=yes
passThroughExcept=HomerView, whose key map is chained into the browsers', where these keys are JAWS's own

[Key Control+C]
owner=Windows
kind=convention
what=copy
context=everywhere
interception=the app receives it
disposition=bind only to copy the current item

[Key Control+V]
owner=Windows
kind=convention
what=paste
context=everywhere
interception=the app receives it
disposition=bind only to paste

[Key Control+X]
owner=Windows
kind=convention
what=cut
context=everywhere
interception=the app receives it
disposition=bind only to cut

[Key Control+Z]
owner=Windows
kind=convention
what=undo
context=everywhere
interception=the app receives it
disposition=bind only to undo

[Key Control+Shift+Z]
owner=Windows
kind=convention
what=redo
context=everywhere
interception=the app receives it
disposition=bind only to redo

[Key Control+Y]
owner=Windows
kind=convention
what=redo or repeat
context=everywhere
interception=the app receives it
disposition=bind only to redo or repeat

[Key Control+F4]
owner=Windows
kind=convention
what=close window
context=MDI apps
interception=the app receives it
disposition=bind only to close the window
jaws=JAWS answers it with its own script, CloseDocumentWindow, before the app (kit 1.259.0, from JAWS's default key maps of 2024 to 2027)
passThrough=yes
passThroughExcept=HomerView, whose key map is chained into the browsers', where these keys are JAWS's own

[Key Control+Tab]
owner=Windows
kind=convention
what=next window
context=MDI apps and dialogs with pages
interception=the app receives it
disposition=bind only to the next window or page

[Key Control+Shift+Tab]
owner=Windows
kind=convention
what=previous window
context=MDI apps and dialogs with pages
interception=the app receives it
disposition=bind only to the previous window or page

[Key Alt+Enter]
owner=Windows
kind=convention
what=properties
context=everywhere
interception=the app receives it
disposition=bind only to properties
jaws=JAWS answers it with its own script, AltEnterKey, before the app (kit 1.259.0, from JAWS's default key maps of 2024 to 2027)
passThrough=yes
passThroughExcept=HomerView, whose key map is chained into the browsers', where these keys are JAWS's own

[Key Alt+LeftArrow]
owner=Windows
kind=convention
what=back
context=navigable views
interception=the app receives it
disposition=bind only to back, or a recorded editor exception

[Key Alt+RightArrow]
owner=Windows
kind=convention
what=forward
context=navigable views
interception=the app receives it
disposition=bind only to forward, or a recorded editor exception

[Key F2]
owner=Windows
kind=convention
what=rename or edit
context=everywhere
interception=the app receives it
disposition=bind only to rename or edit, or a recorded exception

[Key F5]
owner=Windows
kind=convention
what=refresh
context=everywhere
interception=the app receives it
disposition=bind only to refresh, or a recorded exception

[Key Alt+Delete]
owner=JAWS
kind=reader global
what=Say Active Cursor
context=everywhere, desktop layout
interception=JAWS takes it: Say Active Cursor, pixel coordinates in a list
disposition=approved suite override: Say Position, passed through by each app's JAWS key map allowlist
passThrough=yes
passThroughExcept=HomerView, whose key map is chained into the browsers'; its JAWS Say Position script comes in stage 5

[Key Alt+Control+PageUp]
owner=JAWS and NVDA
kind=reader global
what=JAWS: voice rate faster for the moment; NVDA: the first row of the table's column
context=everywhere
interception=JAWS takes it
disposition=approved only for the first row of a grid's column, NVDA's table meaning (DbDo's Column Top); never handed on in a JAWS key map, so JAWS keeps its voice rate (18 November 2026, from NVDA's command reference)

[Key Alt+Control+PageDown]
owner=JAWS and NVDA
kind=reader global
what=JAWS: voice rate slower for the moment; NVDA: the last row of the table's column
context=everywhere
interception=JAWS takes it
disposition=approved only for the last row of a grid's column, NVDA's table meaning (DbDo's Column Bottom); never handed on in a JAWS key map, so JAWS keeps its voice rate (18 November 2026, from NVDA's command reference)

[Key Alt+Shift+UpArrow]
owner=JAWS
kind=reader global
what=mouse up
context=everywhere
interception=JAWS takes it
disposition=never bind

[Key Alt+Shift+DownArrow]
owner=JAWS
kind=reader global
what=mouse down
context=everywhere
interception=JAWS takes it
disposition=never bind

[Key Alt+Shift+LeftArrow]
owner=JAWS
