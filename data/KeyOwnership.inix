owner=JAWS and NVDA
kind=reader tables
what=next cell
context=inside tables and some list views
interception=the reader takes it there
disposition=allowed for cell movement inside the app's own grid only, tested

[Key Alt+Shift+Comma]
owner=JAWS
kind=reader laptop
what=current table cell
context=laptop layout, inside tables
interception=JAWS may take it there
disposition=passed through to the app, wherever it binds the key: DbDo's testSay heard JAWS answer "not in a table" for its Alt+Shift letters (17 November 2026)
passThrough=yes
passThroughExcept=HomerView, whose key map is chained into the browsers', where the table keys are JAWS's own

[Key Alt+Shift+Period]
owner=JAWS
kind=reader laptop
what=next table cell
context=laptop layout, inside tables
interception=JAWS may take it inside a table, in the laptop layout
disposition=passed through to the app, wherever it binds the key: DbDo's testSay heard JAWS answer "not in a table" for its Alt+Shift letters (17 November 2026)
passThrough=yes
passThroughExcept=HomerView, whose key map is chained into the browsers', where the table keys are JAWS's own

[Key Alt+Shift+M]
owner=JAWS
kind=reader laptop
what=previous table cell
context=laptop layout, inside tables
interception=JAWS may take it inside a table, in the laptop layout
disposition=passed through to the app, wherever it binds the key: DbDo's testSay heard JAWS answer "not in a table" for its Alt+Shift letters (17 November 2026)
passThrough=yes
passThroughExcept=HomerView, whose key map is chained into the browsers', where the table keys are JAWS's own

[Key Alt+Shift+N]
owner=JAWS
kind=reader laptop
what=table cell down
context=laptop layout, inside tables
interception=JAWS may take it inside a table, in the laptop layout
disposition=passed through to the app, wherever it binds the key: DbDo's testSay heard JAWS answer "not in a table" for its Alt+Shift letters (17 November 2026)
passThrough=yes
passThroughExcept=HomerView, whose key map is chained into the browsers', where the table keys are JAWS's own

[Key Alt+Shift+Y]
owner=JAWS
kind=reader laptop
what=table cell up
context=laptop layout, inside tables
interception=JAWS may take it inside a table, in the laptop layout
disposition=passed through to the app, wherever it binds the key: DbDo's testSay heard JAWS answer "not in a table" for its Alt+Shift letters (17 November 2026)
passThrough=yes
passThroughExcept=HomerView, whose key map is chained into the browsers', where the table keys are JAWS's own

[Key F6]
owner=Browser
kind=browser
what=panes
context=HomerView only
interception=the browser moves among panes and the address bar
disposition=left to the browser

[Key F11]
owner=Browser
kind=browser
what=full screen
context=HomerView only
interception=full screen
disposition=left to the browser; Elevate Version is Control+F11 there

[Key F12]
